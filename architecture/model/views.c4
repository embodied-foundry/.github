views {
  view index {
    title 'System context'
    include *
    exclude * -> * where kind is implements or kind is produces or kind is consumes or kind is references
  }

  view layers of ef {
    title 'Layers'
    description 'Each layer is a repository. Muted layers do not exist yet.'
    include *
    exclude * -> * where kind is implements or kind is produces or kind is consumes or kind is references
  }

  view runtime {
    title 'Runtime: interchangeable controllers'
    description """
      A human and a policy both implement C3 and drive the same C2 Robot interface through the Arbiter.
      Recording sits on that interface, so demonstrations, rollouts and interventions share one Episode format.
    """
    include
      operator,
      robot,
      ef.core.drivers,
      ef.core.arbiter,
      ef.core.recorder,
      ef.teleop.humanController,
      ef.teleop.operatorUi,
      ef.inference.policyController,
      ef.data.ingest
  }

  view contracts {
    title 'Contracts'
    description 'Layers depend on these, never on each other\'s internals.'
    include ef.** where kind is contract
  }

  dynamic view loop {
    title 'The loop: demonstrate → train → deploy → intervene'
    ef.teleop.humanController -> ef.core.arbiter 'Action (human)'
    ef.core.arbiter -> ef.core.drivers 'Action'
    ef.core.drivers -> ef.core.recorder 'step'
    ef.core.recorder -> ef.data.ingest 'demonstration episode'
    ef.data.curation -> ef.data.registry 'publish dataset version'
    ef.data.registry -> ef.training.trainer 'C5 Dataset'
    ef.training.trainer -> ef.inference.policyLoader 'C6 Policy artifact'
    ef.inference.policyLoader -> ef.inference.policyController 'load'
    ef.inference.policyController -> ef.core.arbiter 'Action (policy)'
    ef.teleop.operatorUi -> ef.core.arbiter 'take over'
    ef.core.recorder -> ef.data.ingest 'rollout + intervention episode'
  }
}
