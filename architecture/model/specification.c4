specification {
  element person {
    style {
      shape person
      color green
    }
  }
  element system
  element layer
  element component {
    style {
      shape component
    }
  }
  element contract {
    style {
      shape document
      color amber
    }
  }
  element store {
    style {
      shape storage
    }
  }
  element hardware {
    style {
      color gray
    }
  }
  element external {
    style {
      color gray
    }
  }

  relationship implements {
    line dotted
    color amber
  }
  relationship produces {
    line dotted
    color amber
  }
  relationship consumes {
    line dotted
    color amber
  }
  relationship references {
    line dotted
    color amber
  }

  // Not built yet; rendered muted so the gap stays visible.
  tag planned {
    color gray
  }
}
