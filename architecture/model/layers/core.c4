model {
  extend ef.core {
    c1 = contract 'C1 Embodiment spec' {
      description 'Action space, observation streams, control rate, frames and units of one robot configuration'
    }
    c2 = contract 'C2 Robot interface' {
      description 'observe() → Observation, act(Action) at the control rate; connect, reset, e-stop'
    }
    c3 = contract 'C3 Controller' {
      description 'step(Observation) → Action; declares source kind (human | policy) and identifier'
    }
    c4 = contract 'C4 Episode' {
      description 'Time-aligned observations and actions with per-step controller source and metadata'
    }

    drivers = component 'Robot drivers' {
      description 'One C2 implementation per embodiment, real or simulated'
    }
    arbiter = component 'Arbiter' {
      description 'Selects which controller acts each step; switching source is how a human takes over'
    }
    recorder = component 'Recorder' {
      description 'Writes every step to a C4 Episode, whoever is in control'
    }

    c2 .references c1 'shaped by'
    c3 .references c1 'shaped by'
    c4 .references c1 'references'

    drivers .implements c2
    recorder .produces c4

    arbiter -> drivers 'Action'
    drivers -> recorder 'Observation + Action + controller source'
  }

  ef.core.drivers -> robot 'commands'
  robot -> ef.core.drivers 'sensor data'
}
