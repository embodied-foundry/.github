model {
  extend ef.teleop {
    deviceAdapters = component 'Device adapters' {
      description 'Normalize raw input from each device type'
    }
    humanController = component 'Human controller' {
      description 'Retargets device input into the embodiment action space'
    }
    operatorUi = component 'Operator UI' {
      description 'Camera feeds, robot state, episode controls and takeover'
    }

    deviceAdapters -> humanController 'normalized device input'
    humanController .implements ef.core.c3
    humanController -> ef.core.arbiter 'Action'
    operatorUi -> ef.core.arbiter 'switch control source'
  }

  devices -> ef.teleop.deviceAdapters 'raw input'
  operator -> ef.teleop.operatorUi 'monitors, starts/stops episodes, takes over'
  ef.core.drivers -> ef.teleop.humanController 'Observation'
  ef.core.drivers -> ef.teleop.operatorUi 'Observation'
}
